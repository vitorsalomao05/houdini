---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import CopyBlock from "../components/CopyBlock.astro";
import Stepper from "../components/Stepper.astro";
import StepCard from "../components/StepCard.astro";
import { installOneLiner, installFromSource, links, surfaces } from "../config";

// The wizard's cards, in order. Drives the progress count and the deep-link
// slugs (/install#connect, /install#widget, …).
const steps = [
  { slug: "install", label: "Run the command" },
  { slug: "connect", label: "Connect a subscription" },
  { slug: "widget", label: "Desktop widget" },
  { slug: "done", label: "You're set" },
];
const total = steps.length;

// Shared classes for the decision toggle buttons.
const choiceClass =
  "stepper-choice flex-1 rounded-card border border-border bg-surface/40 px-4 py-3 text-left text-sm font-medium text-muted transition-colors hover:border-accent/60 hover:text-text aria-[pressed=true]:border-spark/70 aria-[pressed=true]:bg-spark/10 aria-[pressed=true]:text-text";
const panelClass =
  "mt-4 rounded-card border border-border/70 bg-surface-2/40 p-4 text-sm leading-relaxed text-muted";

// Static uninstall commands — kept local to this page (not in config.ts).
const uninstall = `# If you connected Codex, remove only Houdini's separate session:
CODEX_HOME="$HOME/Library/Application Support/Houdini/Codex" codex logout -c 'cli_auth_credentials_store="keyring"'

# If you enabled launch-at-login, unregister it first:
"$HOME/Applications/Houdini.app/Contents/MacOS/Houdini" --unregister-login-item

# Remove the app and the CLI:
rm -rf "$HOME/Applications/Houdini.app"
rm -f  "$HOME/.local/bin/houdini"

# Remove saved preferences + the claude.ai session Houdini stored:
defaults delete org.salomao.houdini 2>/dev/null || true
security delete-generic-password -s Houdini-claude-session 2>/dev/null || true`;
---

<Layout
  title="Install — Houdini"
  description="A guided setup for Houdini: install, choose Claude or Codex, connect through the official client, and choose your surfaces. macOS 14+, Apple Silicon."
>
  <main id="main" tabindex="-1" class="flex-1 pt-28 md:pt-24">
    <!-- Header -->
    <header class="relative overflow-hidden">
      <div
        class="screen-glow pointer-events-none absolute -top-40 right-[-10%] -z-10 h-[440px] w-[440px] opacity-70"
        aria-hidden="true"
      >
      </div>
      <div class="mx-auto max-w-3xl px-5 sm:px-8">
        <span
          data-enter
          style="--enter-i: 0"
          class="inline-flex items-center gap-2.5 font-mono text-xs uppercase tracking-[0.18em] text-accent-text"
        >
          <span
            class="inline-block h-[3px] w-6 rounded-full bg-gradient-to-r from-accent to-magenta"
            aria-hidden="true"></span>
          Install
        </span>
        <h1
          data-enter
          style="--enter-i: 1"
          class="mt-4 font-display text-[2.4rem] font-semibold leading-[1.06] sm:text-5xl"
        >
          A guided setup, start to finish.
        </h1>
        <p data-enter style="--enter-i: 2" class="mt-4 text-lg leading-relaxed text-muted">
          One command installs Houdini. Choose Claude or Codex, connect through
          its official client, and see your limits in the menu bar. No Houdini account or server — your Mac
          talks only to your provider. Step through it below, or read it as one
          page.
        </p>
        <p data-enter style="--enter-i: 3" class="mt-3 font-mono text-xs text-muted">
          macOS 14 (Sonoma)+ · Apple Silicon · free &amp; open source
        </p>
      </div>
    </header>

    <!-- Wizard -->
    <Stepper id="install-wizard" label="Install Houdini, step by step" steps={steps} store>
      <!-- 1 · Run the command (same for everyone) -->
      <StepCard
        slug="install"
        index={0}
        total={total}
        badge="1"
        title="Run the command"
        featured
      >
        <p class="text-sm leading-relaxed text-muted">
          Paste this into Terminal. It downloads Houdini and the
          <code class="font-mono text-text">houdini</code> helper from the pinned
          release, <span class="text-text">verifies their SHA-256</span>, then installs
          without <code class="font-mono text-text">sudo</code> — and with no Gatekeeper
          prompt. It offers (never forces) launch-at-login, and re-running is safe.
        </p>
        <div class="mt-5">
          <CopyBlock
            code={installOneLiner}
            label="install · macOS 14+ · Apple Silicon"
          />
        </div>
      </StepCard>

      <!-- 2 · Connect a subscription (decision) -->
      <StepCard
        slug="connect"
        index={1}
        total={total}
        badge="2"
        title="Connect a subscription"
      >
        <p class="text-sm leading-relaxed text-muted">
          Open Houdini's Settings and choose your subscription. Houdini starts
          sign-in through its official client in your browser; there is no secret
          to paste into Houdini. Settings links to client setup if it is missing.
        </p>
        <div
          class="mt-5 flex flex-col gap-3 sm:flex-row"
          role="group"
          aria-label="Which subscription do you want to connect?"
          data-no-arrow-nav
        >
          <p class="sr-only" id="connect-q">Which subscription do you want to connect?</p>
          <button
            type="button"
            class={choiceClass}
            data-choice="subscription"
            data-value="claude"
            data-default
            aria-pressed="true"
            aria-describedby="connect-q"
          >
            Claude
          </button>
          <button
            type="button"
            class={choiceClass}
            data-choice="subscription"
            data-value="codex"
            aria-pressed="false"
            aria-describedby="connect-q"
          >
            Codex
          </button>
        </div>
        <div class={panelClass} data-choice-panel="subscription" data-value="claude">
          If Claude Code is already signed in with a usable Pro/Max credential,
          Houdini can read it. Otherwise choose <strong class="text-text">Connect
          Claude</strong> and finish Claude Code's browser sign-in. This updates
          your Claude Code session. Existing saved Claude.ai sessions remain a fallback.
        </div>
        <div class={panelClass} data-choice-panel="subscription" data-value="codex">
          Install the official <strong class="text-text">Codex CLI 0.150.x</strong>,
          then choose <strong class="text-text">Connect Codex</strong> and finish
          sign-in in your browser. The official client keeps a separate Houdini
          session in your Keychain; your usual Codex login stays unchanged. Houdini
          displays the Codex quota windows your account returns.
        </div>
      </StepCard>

      <!-- 3 · Desktop widget (decision) -->
      <StepCard
        slug="widget"
        index={2}
        total={total}
        badge="3"
        title="Desktop widget"
      >
        <p class="text-sm leading-relaxed text-muted">
          Houdini is one app, and the same data can show up in two places. The
          menu bar is always on. The desktop widget is optional — your call:
        </p>
        <div
          class="mt-5 flex flex-col gap-3 sm:flex-row"
          role="group"
          aria-label="Do you want the desktop widget?"
          data-no-arrow-nav
        >
          <p class="sr-only" id="widget-q">Do you want the desktop widget?</p>
          <button
            type="button"
            class={choiceClass}
            data-choice="widget"
            data-value="yes"
            data-default
            aria-pressed="true"
            aria-describedby="widget-q"
          >
            Yes, put it on my desktop
          </button>
          <button
            type="button"
            class={choiceClass}
            data-choice="widget"
            data-value="no"
            aria-pressed="false"
            aria-describedby="widget-q"
          >
            No, menu bar only
          </button>
        </div>
        <div class={panelClass} data-choice-panel="widget" data-value="yes">
          Turn it on in <strong class="text-text">Settings ▸ Show desktop
          widget</strong>. Drag it by the background, resize from the edges, and
          park it anywhere on your wallpaper — same gauges, same 60-second refresh.
        </div>
        <div class={panelClass} data-choice-panel="widget" data-value="no">
          Just the menu bar, then — <strong class="text-text">always in
          view</strong>, never in the way. You can switch the widget on later in
          Settings whenever you like.
        </div>

        <details
          class="group mt-5 rounded-card border border-border bg-surface/40 p-4"
        >
          <summary
            class="cursor-pointer list-none text-sm font-medium text-muted transition-colors hover:text-text"
          >
            What's included <span class="text-accent-text">— the two surfaces</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            Both are the same Houdini — one app, one install. Use one or both.
          </p>
          <div class="mt-3 grid gap-3 sm:grid-cols-2">
            {
              surfaces.map((s) => (
                <div class="rounded-card border border-border bg-surface/50 p-4">
                  <div class="flex items-center gap-2">
                    <h3 class="text-sm font-semibold">{s.title}</h3>
                    <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-ok">
                      <span
                        class="h-1.5 w-1.5 rounded-full bg-ok"
                        aria-hidden="true"
                      />
                      Built in
                    </span>
                  </div>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted">
                    {s.body}
                  </p>
                </div>
              ))
            }
          </div>
        </details>
      </StepCard>

      <!-- 4 · You're set (personalised recap) -->
      <StepCard
        slug="done"
        index={3}
        total={total}
        badge="✓"
        title="You're set"
        featured
      >
        <p class="text-sm leading-relaxed text-muted">
          Your tightest limit is now in the menu bar, color-coded and refreshed
          every 60 seconds. Click it for the full popover — every window, its
          reset timer, and any extra-usage spend.
        </p>

        <p class="mt-5 font-mono text-xs uppercase tracking-[0.16em] text-accent-text">
          Your setup
        </p>
        <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-muted">
          <li class="flex gap-3" data-recap-when="subscription:claude">
            <span class="mt-0.5 shrink-0 text-spark" aria-hidden="true">✓</span>
            <span>
              <strong class="text-text">Check Claude in Settings.</strong> A
              current usage reading confirms the connection after Claude Code sign-in.
            </span>
          </li>
          <li class="flex gap-3" data-recap-when="subscription:codex">
            <span class="mt-0.5 shrink-0 text-spark" aria-hidden="true">✓</span>
            <span>
              <strong class="text-text">Check Codex in Settings.</strong> After
              browser sign-in, Houdini shows the available quota windows and reset timers.
            </span>
          </li>
          <li class="flex gap-3" data-recap-when="widget:yes">
            <span class="mt-0.5 shrink-0 text-spark" aria-hidden="true">✓</span>
            <span>
              <strong class="text-text">Desktop widget on.</strong> Enable it in
              Settings ▸ Show desktop widget — drag by the background, resize from
              the edges.
            </span>
          </li>
          <li class="flex gap-3" data-recap-when="widget:no">
            <span class="mt-0.5 shrink-0 text-spark" aria-hidden="true">✓</span>
            <span>
              <strong class="text-text">Menu bar only.</strong> Always in view —
              turn the desktop widget on later if you change your mind.
            </span>
          </li>
        </ul>

        <div
          class="mt-6 rounded-card border border-border bg-surface/40 p-5 text-center"
        >
          <p class="text-sm text-muted">
            New here? The guide walks through what Houdini tracks, how to read
            every gauge, and what stays on your Mac.
          </p>
          <div class="mt-4 flex flex-wrap justify-center gap-3">
            <Button href={links.guide} variant="primary">Read the guide</Button>
            <Button href={links.github} variant="secondary" external>
              View on GitHub
            </Button>
          </div>
        </div>
      </StepCard>
    </Stepper>

    <!-- For developers — discreet, off the main path -->
    <section class="mx-auto mt-10 max-w-3xl px-5 pb-4 sm:px-8">
      <details class="group rounded-card border border-border bg-surface/40 p-5">
        <summary
          class="cursor-pointer list-none text-sm font-medium text-muted transition-colors hover:text-text"
        >
          For developers — build from source <span class="text-accent-text"
            >Show the commands</span
          >
        </summary>
        <div class="mt-4">
          <p class="text-sm leading-relaxed text-muted">
            Prefer to compile it yourself? Clone the repo and build the app.
            Needs the Xcode Command Line Tools.
          </p>
          <div class="mt-3">
            <CopyBlock code={installFromSource} label="build from source" />
          </div>
        </div>
      </details>
    </section>

    <!-- Uninstall — discreet, off the main path -->
    <section class="mx-auto mt-2 max-w-3xl px-5 pb-4 sm:px-8">
      <details class="group rounded-card border border-border bg-surface/40 p-5">
        <summary
          class="cursor-pointer list-none text-sm font-medium text-muted transition-colors hover:text-text"
        >
          Uninstall — remove Houdini completely <span class="text-accent-text"
            >Show the commands</span
          >
        </summary>
        <div class="mt-4">
          <p class="text-sm leading-relaxed text-muted">
            Quit Houdini (menu bar ▸ Quit). If you connected Codex, the first command
            asks its official client to remove Houdini's separate session; skip it
            if you never connected Codex. Then remove the app, CLI, and saved preferences:
          </p>
          <div class="mt-3">
            <CopyBlock code={uninstall} label="uninstall Houdini" />
          </div>
          <p class="mt-3 text-sm leading-relaxed text-muted">
            You can also remove <code class="font-mono text-text">~/Library/Application Support/Houdini/Codex</code>
            after logout. These steps preserve Claude Code's credential and your
            usual <code class="font-mono text-text">~/.codex</code> configuration.
          </p>
        </div>
      </details>
    </section>

    <!-- Closing CTA -->
    <section class="mx-auto mt-2 max-w-3xl px-5 pb-8 sm:px-8">
      <div
        class="relative overflow-hidden rounded-frame ring-grad p-8 text-center sm:p-12"
      >
        <div
          class="spotlight pointer-events-none absolute inset-0 -z-10 opacity-50"
          aria-hidden="true"
        >
        </div>
        <h2 class="font-display text-2xl font-semibold sm:text-3xl">
          Pull your limits into the light.
        </h2>
        <p class="mx-auto mt-3 max-w-md text-muted">
          One line, no Gatekeeper prompt, no account, no server.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <Button href={links.guide} variant="primary" size="lg">
            Read the guide
          </Button>
          <Button href={links.github} variant="secondary" size="lg" external>
            View on GitHub
          </Button>
        </div>
      </div>
    </section>
  </main>
</Layout>
